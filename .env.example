# ============================================
# SIVASAKTHI MEN'S SALON — Environment example
# Copy to backend/.env and frontend/.env
# NEVER commit real secrets.
# ============================================

# ---------- Backend (backend/.env) ----------
# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/sivasakthi_salon

# JWT (used for admin session signing/verification)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Client URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Default admin (used ONLY by the seed script, then you should change the password)
ADMIN_EMAIL=admin@sivasakthisalon.in
ADMIN_PASSWORD=ChangeMe123!

# File storage provider: "local" | "cloudinary"
#   local      = dev only. Uploads live on this machine and return localhost URLs.
#   cloudinary = REQUIRED for production. Uploads are pushed to Cloudinary and the
#                durable public https URL is returned and stored in the database.
# With cloudinary, ALL THREE CLOUDINARY_* values must be set; if any is missing the
# backend refuses to save the file locally (never falls back to a temporary
# Render filesystem path or a localhost URL).
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Frontend (frontend/.env) ----------
VITE_API_URL=http://localhost:5000/api
# Image upload size cap in MB. MUST match the backend's MAX_IMAGE_UPLOAD_MB
# (default 10 on both sides). The client waits on this value; the backend
# enforces it with multer.
VITE_MAX_IMAGE_UPLOAD_MB=10
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps?q=Sivasakthi+Men%27s+Salon,+Rosalpatti,+Tamil+Nadu+626001&output=embed

# EmailJS — booking/status email notifications (required for emails to send).
# Get these from https://dashboard.emailjs.com — only public values live here,
# never the private key. The recipient for admin notifications is configured
# inside the EmailJS templates, not in code.
# - VITE_EMAILJS_TEMPLATE_ID: new booking notification (status = Pending)
# - VITE_EMAILJS_STATUS_TEMPLATE_ID: status change notifications (Confirmed/Rejected)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_STATUS_TEMPLATE_ID=